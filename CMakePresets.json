                }
            ]
        }
    ],
    "packagePresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "generators": ["DEB"]
        },
        {
            "name": "release-vcpkg",
            "configurePreset": "release-vcpkg",
            "generators": ["DEB"]
        }
    ]
}
