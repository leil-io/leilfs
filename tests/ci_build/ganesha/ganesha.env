# Single source of truth for the NFS-Ganesha release the whole codebase builds
# and deploys. Consumed by:
#   - tests/ci_build/ganesha/build-ganesha.sh (CI workflow + Ganesha Docker image)
#   - cmake/Libraries.cmake (builds the SaunaFS FSAL against these headers)
#
# ntirpc is intentionally NOT pinned here: it is resolved from THIS release's git
# submodule at build time, so it always tracks the Ganesha version automatically.
GANESHA_VERSION=V9.15
GANESHA_GIT_URL=https://github.com/nfs-ganesha/nfs-ganesha.git
